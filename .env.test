# ─────────────────────────────────────────────────────────────────────────────
# Entorno de PRUEBAS. Se versiona a propósito (a diferencia de .env): solo contiene
# valores dummy y credenciales de una base de datos local/efímera. NO pongas aquí
# secretos reales — para eso están .env (local, ignorado) y los Secrets de CI/Vercel.
#
# Consumidores:
#   - docker-compose.test.yml lo carga con env_file y sobrescribe las URLs de DB
#     para usar el host "postgres" (red interna). Aquí van con "localhost" para
#     poder correr los tests con DB local: `pnpm db:up && pnpm test:integration`.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=test

# Valores de prueba (no secretos). Solo deben ser strings no vacíos / URLs válidas.
AUTH_SECRET=test-secret-not-for-production
AUTH_GOOGLE_ID=test-google-id
AUTH_GOOGLE_SECRET=test-google-secret
APP_URL=http://localhost:3000

# Postgres de test. Host "localhost" para uso local (el compose lo cambia a "postgres").
# app_user (NOBYPASSRLS) para la app; postgres (owner) para migraciones y seed.
DATABASE_URL=postgresql://app_user:app_pw@localhost:5432/chartwise
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/chartwise
