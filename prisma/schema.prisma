datasource db {
  provider = "postgresql"
  // Prisma 7: las URLs de conexión NO van aquí.
  //  - Migraciones/CLI  -> prisma.config.ts (datasource.url = DIRECT_URL, rol owner).
  //  - Cliente runtime  -> driver adapter @prisma/adapter-pg con DATABASE_URL (rol app_user).
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Raíz de tenancy: ancla del aislamiento. No tiene tenantId (ES el tenant).
// Retrofit ADR-006 (define ahora, usa después): i18n, slugs previos y soft delete.
// El slug NUNCA es clave de consulta: se resuelve a id y se descarta.
model Tenant {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique
  name          String
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  timezone      String    @default("UTC")
  currency      String    @default("USD")
  locale        String    @default("es")
  previousSlugs String[]  @default([])
  deletedAt     DateTime? @db.Timestamptz(6)
  notes         Note[]
}

// Agregado tenant-scoped del módulo `example` (placeholder para probar la multitenancy).
// RLS (ENABLE/FORCE + POLICY por current_setting('app.current_tenant')) se añade a mano
// en el SQL de la migración (T043), no se modela aquí.
model Note {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  title     String
  body      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Retrofit ADR-006: índice obligatorio de tabla de negocio -> FKs tenant-safe.
  @@unique([tenantId, id])
  @@index([tenantId])
}
