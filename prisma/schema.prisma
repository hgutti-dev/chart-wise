datasource db {
  provider = "postgresql"
  // Prisma 7: las URLs de conexión NO van aquí.
  //  - Migraciones/CLI  -> prisma.config.ts (datasource.url = DIRECT_URL, rol owner).
  //  - Cliente runtime  -> driver adapter @prisma/adapter-pg con DATABASE_URL (rol app_user).
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Raíz de tenancy: ancla del aislamiento. No tiene tenantId (ES el tenant).
// Retrofit ADR-006 (define ahora, usa después): i18n, slugs previos y soft delete.
// El slug NUNCA es clave de consulta: se resuelve a id y se descarta.
model Tenant {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique
  name          String
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  timezone      String    @default("UTC")
  currency      String    @default("USD")
  locale        String    @default("es")
  previousSlugs String[]  @default([])
  deletedAt     DateTime? @db.Timestamptz(6)
  notes         Note[]
}

// Agregado tenant-scoped del módulo `example` (placeholder para probar la multitenancy).
// RLS (ENABLE/FORCE + POLICY por current_setting('app.current_tenant')) se añade a mano
// en el SQL de la migración (T043), no se modela aquí.
model Note {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  title     String
  body      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Retrofit ADR-006: índice obligatorio de tabla de negocio -> FKs tenant-safe.
  @@unique([tenantId, id])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Identidad (módulo `identity`, Fase 2). AuthN only. Ver docs/specs/002-authentication/data-model.md.
// NO son tenant-scoped: un User es una identidad global entre tenants -> SIN tenantId,
// SIN RLS y SIN el par @@index([tenantId]) + @@unique([tenantId, id]). Solo GRANT a
// app_user (editado a mano en el SQL de la migración). SIN tabla de sesión (estrategia JWT).
// ─────────────────────────────────────────────────────────────────────────────

// Identidad global de una persona. `email` normalizado (VO Email) y único global.
// `passwordHash` null en cuentas solo-OAuth; `emailVerified` null = no verificado.
model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  emailVerified DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  accounts      Account[]
}

// Proveedor OAuth (Google) vinculado a un User. Forma estándar del adapter de Auth.js:
// los nombres de columna son los que el adapter espera (confirmados con Context7).
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Token de verificación de email. Forma estándar del adapter: clave compuesta, sin `id` propio.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
}
