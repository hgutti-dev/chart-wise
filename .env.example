# Copia este archivo a .env y rellena los valores. NO commitees .env.
NODE_ENV=

# Secreto de Auth.js. Genera uno con: openssl rand -base64 32
AUTH_SECRET=

# Postgres — conexión de la app (rol sin BYPASSRLS; en Neon, la cadena "pooled").
DATABASE_URL=

# Postgres — conexión directa para migraciones (Neon "direct"; en local, el owner).
DIRECT_URL=
