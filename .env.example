# Copia este archivo a .env y rellena los valores. NO commitees .env.
NODE_ENV=

# Secreto de Auth.js. Genera uno con: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (Auth.js). Crea un "OAuth client ID" (tipo Web application) en
# Google Cloud Console > APIs & Services > Credentials.
# Redirect URI (para fases posteriores): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL pública de la app; base de los enlaces de verificación de email.
# Si se omite, el schema usa el default http://localhost:3000
APP_URL=

# (Opcional) Puerto del host para el Postgres de Docker. Default 5432; usa otro (p. ej. 5433)
# si ya tienes un Postgres nativo en 5432. Debe coincidir con el puerto de las URLs de abajo.
DB_HOST_PORT=

# Postgres — conexión de la app (rol sin BYPASSRLS; en Neon, la cadena "pooled").
DATABASE_URL=

# Postgres — conexión directa para migraciones (Neon "direct"; en local, el owner).
DIRECT_URL=
